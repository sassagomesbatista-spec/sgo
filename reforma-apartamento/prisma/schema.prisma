// Modelo de dados — Gerenciador de Reforma de Apartamento
//
// Decisão técnica: todo valor financeiro é armazenado como Int (centavos de R$),
// nunca como Float. Isso evita erro de ponto flutuante independente do banco e
// funciona igual em SQLite ou Postgres — poderia virar Decimal(14,2) no Postgres
// sem mudar a lógica de negócio, que já trata tudo como inteiro.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Usuários e projeto ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("owner") // owner | collaborator (preparado p/ multiusuário)
  createdAt    DateTime @default(now())

  projetos ProjetoUsuario[]
}

// Tabela de junção usuário<->projeto: já prepara o modelo para múltiplos
// colaboradores por reforma, mesmo com um único usuário hoje.
model ProjetoUsuario {
  id        String  @id @default(cuid())
  projetoId String
  userId    String
  papel     String  @default("owner") // owner | editor | leitor
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projetoId, userId])
}

model Projeto {
  id                        String   @id @default(cuid())
  nome                      String
  moeda                     String   @default("BRL")
  timezone                  String   @default("America/Sao_Paulo")
  orcamentoTotalCentavos    Int
  reservaContingenciaPercent Float   @default(10)
  dataInicioPrevista        DateTime
  dataTerminoPrevista       DateTime
  dataTerminoRevisada       DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  usuarios     ProjetoUsuario[]
  ambientes    Ambiente[]
  categorias   Categoria[]
  fornecedores Fornecedor[]
  orcamentoItens OrcamentoItem[]
  lancamentos  Lancamento[]
  tarefas      Tarefa[]
  cotacoes     Cotacao[]
  contratos    Contrato[]
  documentos   Documento[]
  cenarios     Cenario[]
}

// ---------- Cadastros de apoio ----------

model Ambiente {
  id        String   @id @default(cuid())
  projetoId String
  nome      String
  ordem     Int      @default(0)
  orcamentoCentavos Int @default(0)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  projeto        Projeto         @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  orcamentoItens OrcamentoItem[]
  lancamentos    Lancamento[]
  tarefas        Tarefa[]
  documentos     Documento[]
}

model Categoria {
  id        String   @id @default(cuid())
  projetoId String
  nome      String
  grupo     String // ex: "Obra civil", "Instalações", "Móveis e decoração"...
  orcamentoCentavos Int @default(0)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  projeto        Projeto         @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  orcamentoItens OrcamentoItem[]
  lancamentos    Lancamento[]
  tarefas        Tarefa[]
}

model Fornecedor {
  id               String    @id @default(cuid())
  projetoId        String
  nome             String
  tipo             String // pessoa física | empresa
  empresa          String?
  documento        String? // CPF ou CNPJ
  telefone         String?
  email            String?
  endereco         String?
  dadosBancarios   String?
  pix              String?
  contatoPrincipal String?
  especialidade    String?
  avaliacao        Int?      // 1-5
  status           String    @default("ativo") // ativo | inativo
  observacoes      String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  projeto     Projeto      @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  lancamentos Lancamento[]
  tarefas     Tarefa[]
  cotacoes    Cotacao[]
  contratos   Contrato[]
  documentos  Documento[]
}

// ---------- Orçamento ----------

model OrcamentoItem {
  id                 String   @id @default(cuid())
  projetoId          String
  nome               String
  descricao          String?
  categoriaId        String?
  ambienteId         String?
  etapaId            String?
  valorEstimadoCentavos   Int @default(0)
  valorAprovadoCentavos   Int @default(0)
  valorContratadoCentavos Int @default(0)
  valorPagoCentavos       Int @default(0)
  prioridade         String   @default("media") // alta | media | baixa
  observacoes        String?
  deletedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  projeto   Projeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  categoria Categoria? @relation(fields: [categoriaId], references: [id])
  ambiente  Ambiente?  @relation(fields: [ambienteId], references: [id])
  etapa     Tarefa?    @relation(fields: [etapaId], references: [id])
}

// ---------- Lançamentos financeiros ----------

model Lancamento {
  id                String    @id @default(cuid())
  projetoId         String
  tipo              String // entrada | saida
  descricao         String
  valorCentavos     Int
  dataLancamento    DateTime
  dataCompetencia   DateTime?
  dataVencimento    DateTime?
  dataPagamento     DateTime?
  status            String // previsto | em_cotacao | aguardando_aprovacao | aprovado | contratado |
                            // aguardando_pagamento | pago_parcialmente | pago | vencido | cancelado | reembolsado
  categoriaId       String?
  ambienteId        String?
  etapaId           String?
  fornecedorId      String?
  formaPagamento    String?
  contaOrigemDestino String?
  numeroParcelas    Int?      @default(1)
  parcelaAtual      Int?      @default(1)
  grupoParcelaId    String?   // agrupa lançamentos da mesma compra parcelada
  recorrencia       String?   // nenhuma | mensal | bimestral | anual...
  observacoes       String?
  tags              String?   // csv simples
  notaFiscal        String?
  comprovanteUrl    String?
  contratoId        String?
  deletedAt         DateTime? // exclusão lógica (nunca hard-delete de registro financeiro)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  projeto    Projeto     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  categoria  Categoria?  @relation(fields: [categoriaId], references: [id])
  ambiente   Ambiente?   @relation(fields: [ambienteId], references: [id])
  etapa      Tarefa?     @relation(fields: [etapaId], references: [id])
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id])
  contrato   Contrato?   @relation(fields: [contratoId], references: [id])
}

// ---------- Cronograma ----------

model Tarefa {
  id                     String    @id @default(cuid())
  projetoId              String
  titulo                 String
  descricao              String?
  ambienteId             String?
  categoriaId            String?
  responsavel            String?
  fornecedorId           String?
  dataInicioPlanejada    DateTime
  dataTerminoPlanejada   DateTime
  dataInicioReal         DateTime?
  dataTerminoReal        DateTime?
  percentualConcluido    Int       @default(0)
  status                 String    @default("nao_iniciado")
  // nao_iniciado | aguardando_decisao | aguardando_material | aguardando_fornecedor |
  // em_andamento | pausado | atrasado | concluido | cancelado
  prioridade             String    @default("media")
  custoPrevistoCentavos  Int       @default(0)
  custoRealizadoCentavos Int       @default(0)
  ehMarco                Boolean   @default(false)
  observacoes            String?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  projeto      Projeto         @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  ambiente     Ambiente?       @relation(fields: [ambienteId], references: [id])
  categoria    Categoria?      @relation(fields: [categoriaId], references: [id])
  fornecedor   Fornecedor?     @relation(fields: [fornecedorId], references: [id])
  dependeDe    TarefaDependencia[] @relation("Dependente")
  dependentes  TarefaDependencia[] @relation("Precedente")
  orcamentoItens OrcamentoItem[]
  lancamentos  Lancamento[]
  documentos   Documento[]
}

model TarefaDependencia {
  id            String @id @default(cuid())
  tarefaId      String // tarefa que depende
  dependeDeId   String // tarefa da qual depende (precedente)

  tarefa    Tarefa @relation("Dependente", fields: [tarefaId], references: [id], onDelete: Cascade)
  dependeDe Tarefa @relation("Precedente", fields: [dependeDeId], references: [id], onDelete: Cascade)

  @@unique([tarefaId, dependeDeId])
}

// ---------- Cotações e propostas ----------

model Cotacao {
  id              String    @id @default(cuid())
  projetoId       String
  itemDescricao   String
  fornecedorId    String?
  valorCentavos   Int
  prazoDias       Int?
  formaPagamento  String?
  validade        DateTime?
  garantia        String?
  freteCentavos   Int?      @default(0)
  instalacaoCentavos Int?   @default(0)
  impostosCentavos   Int?   @default(0)
  observacoes     String?
  arquivoUrl      String?
  statusSelecao   String    @default("em_analise") // em_analise | preferida | aprovada | descartada
  melhorPreco     Boolean   @default(false)
  melhorPrazo     Boolean   @default(false)
  melhorCustoBeneficio Boolean @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  projeto    Projeto     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id])
}

// ---------- Compras e contratos ----------

model Contrato {
  id              String    @id @default(cuid())
  projetoId       String
  fornecedorId    String?
  escopo          String
  valorTotalCentavos Int
  dataInicio      DateTime?
  dataFim         DateTime?
  formaPagamento  String?
  parcelasJson    String?   // detalhamento livre em JSON
  reajustes       String?
  multas          String?
  prazo           String?
  garantia        String?
  status          String    @default("ativo") // rascunho | ativo | concluido | cancelado
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  projeto     Projeto      @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  fornecedor  Fornecedor?  @relation(fields: [fornecedorId], references: [id])
  lancamentos Lancamento[]
  documentos  Documento[]
}

// ---------- Documentos ----------

model Documento {
  id              String    @id @default(cuid())
  projetoId       String
  nome            String
  tipo            String // contrato | proposta | orcamento | nota_fiscal | recibo | comprovante |
                          // planta | projeto | manual | garantia | foto | ata | autorizacao | condominio
  url             String
  versao          Int       @default(1)
  responsavel     String?
  ambienteId      String?
  etapaId         String?
  fornecedorId    String?
  contratoId      String?
  statusAprovacao String    @default("pendente") // pendente | aprovado | rejeitado
  tags            String?
  dataValidade    DateTime?
  arquivoAnteriorId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  projeto    Projeto     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  ambiente   Ambiente?   @relation(fields: [ambienteId], references: [id])
  etapa      Tarefa?     @relation(fields: [etapaId], references: [id])
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id])
  contrato   Contrato?   @relation(fields: [contratoId], references: [id])
}

// ---------- Simulação de cenários ----------

model Cenario {
  id          String   @id @default(cuid())
  projetoId   String
  nome        String
  tipo        String   // otimista | provavel | pessimista
  descricao   String?
  ajustePrazoDias      Int   @default(0)
  ajusteCustoPercent   Float @default(0)
  usaReservaPercent    Float @default(0)
  createdAt   DateTime @default(now())

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}
