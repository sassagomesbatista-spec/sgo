# Banco de dados PostgreSQL. Localmente, aponte para um Postgres rodando na sua
# máquina (ou Docker); em produção (Vercel), use a connection string fornecida
# pela integração de Storage (Postgres/Neon).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/reforma_apartamento"

# Segredo usado para assinar o cookie de sessão (JWT via jose). Gere um valor
# aleatório forte, por exemplo com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres"

# URL pública da aplicação (usada em referências absolutas quando necessário).
NEXTAUTH_URL="http://localhost:3000"

# Defina como "true" apenas se quiser forçar a recriação dos dados fictícios de
# demonstração num banco que já tem dados (o seed normal é idempotente e não
# apaga nada se já existir um projeto).
FORCE_RESEED="false"
